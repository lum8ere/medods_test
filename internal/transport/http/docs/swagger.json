{
    "swagger": "2.0",
    "info": {
        "description": "CRUD API for tasks built with clean architecture.",
        "title": "Task Service API",
        "contact": {},
        "version": "1.0.1"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/tasks": {
            "get": {
                "description": "Возвращает список задач с фильтрацией по датам и пагинацией",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Получить список задач",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Начало (YYYY-MM-DD)",
                        "name": "start",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Конец (YYYY-MM-DD)",
                        "name": "end",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Лимит (default 20)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Смещение",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_transport_http_handlers.taskDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Создает одну задачу или серию периодических задач на основе правила",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Создать задачу",
                "parameters": [
                    {
                        "description": "Данные задачи",
                        "name": "task",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handlers.taskMutationDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handlers.taskDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "example_com_taskservice_internal_domain_task.Status": {
            "type": "string",
            "enum": [
                "new",
                "in_progress",
                "done"
            ],
            "x-enum-varnames": [
                "StatusNew",
                "StatusInProgress",
                "StatusDone"
            ]
        },
        "internal_transport_http_handlers.recurrenceDTO": {
            "type": "object",
            "properties": {
                "interval_days": {
                    "type": "integer"
                },
                "monthly_day": {
                    "type": "integer"
                },
                "parity": {
                    "type": "string"
                },
                "specific_dates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "type": {
                    "type": "string"
                },
                "valid_until": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http_handlers.taskDTO": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "status": {
                    "$ref": "#/definitions/example_com_taskservice_internal_domain_task.Status"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http_handlers.taskMutationDTO": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "recurrence": {
                    "$ref": "#/definitions/internal_transport_http_handlers.recurrenceDTO"
                },
                "scheduled_date": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/example_com_taskservice_internal_domain_task.Status"
                },
                "title": {
                    "type": "string"
                }
            }
        }
    }
}